<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Central Package Management for Zonit.Services.Dashboard -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Version -->
    <!--
      Versioning policy: track .NET major version, in lockstep with Zonit.Extensions.
      Currently aligned with .NET 10.

      AssemblyVersion stays frozen at 10.0.0.0 for the whole 10.x line so preview churn
      never forces binding redirects on consumers; FileVersion tracks the preview number
      (binding-neutral) so two preview DLLs stay distinguishable to Explorer / crash triage.

      Both are written out literally rather than derived from $(Version) — AssemblyVersion
      and FileVersion take a four-part NUMERIC version, so "10.0.0-preview.11" is not a legal
      value for them. The previous <AssemblyVersion>$(Version)</AssemblyVersion> only ever
      worked because $(Version) was the plain 0.1.63 it was left at.
    -->
    <Version>10.0.0-preview.29</Version>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.29</FileVersion>
    <!-- Package Output -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\Packages</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <!-- Package files (icon and README) -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\Asset\icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\Readme.md"
          Condition="Exists('$(MSBuildProjectDirectory)\Readme.md')"
          Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
  <!--
    AI context delivery - ship the instruction docs and their MSBuild installer, so a consumer's
    assistant learns this package at build time. Same mechanism as Zonit.Extensions; see
    buildTransitive/Zonit.Dashboard.Instructions.targets.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\Zonit.Dashboard.Instructions.targets"
          Pack="true" PackagePath="buildTransitive\Zonit.Dashboard.Instructions.targets" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\Zonit.Dashboard.targets"
          Pack="true" PackagePath="buildTransitive\Zonit.Dashboard.targets" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\Instruction\dashboard\*.md"
          Pack="true" PackagePath="Instruction\dashboard" Visible="false" />
  </ItemGroup>

  <!-- Common Dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.11" />
    <PackageVersion Include="MudBlazor" Version="9.8.0" />
    <PackageVersion Include="MudBlazor.Translations" Version="3.4.0" />
    <!--
      preview.16 is a HARD MINIMUM, not a courtesy bump: Components/DashboardApp.cs derives from
      Zonit.Extensions.Website.AppBase, and that type does not exist before .16. Verified by
      building this project standalone (-p:IsZonitSdkWorkspace=false) against each pin — .13 fails
      with CS0246 'AppBase', and the type is absent from the .13, .14 and .15 assemblies alike.

      Earlier floor, still in force: the dashboard ships /401, /403, /404 and /500 pages, dead in
      Production before the preview.11 kernel fix (UseStatusCodePagesWithReExecute was registered
      only in the Development branch, so a 404 outside Development returned an empty body).

      Publishing the matching Zonit.Extensions release is therefore a prerequisite for publishing
      this package. Inside the SDK workspace these pins are BYPASSED in favour of the source-side
      ProjectReference, so an ordinary local build does not tell you whether they resolve — to
      exercise them, build with -p:IsZonitSdkWorkspace=false.
    -->
    <PackageVersion Include="Zonit.Extensions.Website" Version="10.0.0-preview.26" />
    <PackageVersion Include="Zonit.Extensions.Website.MudBlazor" Version="10.0.0-preview.26" />
    <!--
      Zonit.Messaging is on the 10.x line too — these sat at 1.1.0, a version this package has
      not built against for a while. It never surfaced because the workspace substitutes a
      ProjectReference and the packed nuspec then reports the referenced project's version
      (10.0.0-preview.2), so the pin below is only ever consulted by a standalone build.
    -->
    <PackageVersion Include="Zonit.Services.EventMessage" Version="10.0.0-preview.2" />
    <PackageVersion Include="Zonit.Messaging.Tasks.Abstractions" Version="10.0.0-preview.2" />
  </ItemGroup>
  <!--
    Shared-framework assemblies, pinned only because Central Package Management requires a version
    for every PackageReference. They are a FLOOR, not a choice about what runs: an ASP.NET Core
    host already carries these, and NuGet takes the highest version in the graph regardless.

    No TargetFramework condition, because there is one target. The net8.0 and net9.0 blocks that
    used to sit here were dead the moment this package went net10-only — never evaluated, but still
    read as multi-targeting by anything scanning the file, which is why dotnet-update-report.json
    still lists a "FrameworksSet" of three.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>
</Project>