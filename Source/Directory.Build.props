<Project>
  <!-- Continue the Directory.Build.props chain upwards. Without this, MSBuild
       stops walking parents at the first Directory.Build.props it finds, so
       Sdk-root's <IsZonitSdkWorkspace>true</IsZonitSdkWorkspace> never reaches
       Zonit.Dashboard.csproj — which then falls back to <PackageReference
       Include="Zonit.Extensions.Website"> instead of the source-side
       ProjectReference, leading to type-version conflicts in the Documents host
       (CS0234 / CS0433 on IBreadcrumbsProvider, ITenantProvider, IWebsiteArea, …). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
          Condition="'$([MSBuild]::GetPathOfFileAbove(`Directory.Build.props`, `$(MSBuildThisFileDirectory)../`))' != ''" />

  <!-- Common NuGet Package Metadata for all Zonit.Services.Dashboard packages -->
  <PropertyGroup>
    <Authors>Zonit</Authors>
    <Company>Zonit</Company>
    <Product>Zonit.Services.Dashboard</Product>
    <Copyright>Copyright (c) Zonit</Copyright>
    
    <!-- Repository and Project URLs -->
    <PackageProjectUrl>https://github.com/Zonit/Zonit.Services.Dashboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Zonit/Zonit.Services.Dashboard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/Zonit/Zonit.Services.Dashboard/releases</PackageReleaseNotes>
    
    <!-- Build settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!--
      Trimming: yes. Native AOT: no, and saying otherwise would be a lie.

      Zonit.Dashboard's own code is trim-annotated and produces zero IL warnings, but the
      package is a Blazor UI library and two things it cannot avoid are not AOT-clean:

        * Blazor routing. The Router / LayoutView / RouteView the bundled Routes.razor uses
          set properties carrying [DynamicallyAccessedMembers] through reflection - IL2111 and
          IL2110, raised inside the Razor-generated Routes_razor.g.cs, not in code we own.
        * MudBlazor 9.x, the entire point of this package, reports IL3050 (MakeGenericType in
          the converter dispatcher) and IL2075 under ILC.

      AddDashboard() therefore carries [RequiresUnreferencedCode]/[RequiresDynamicCode],
      propagated from AddWebsite, so a consumer publishing AOT gets a build-time diagnostic
      instead of a runtime surprise. Flip IsAotCompatible back on only when both of the above
      are genuinely clean - not to silence the analyser.
    -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  
  <!-- Language settings -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
