<Project>

  <!--
    ============================================================================
    Zonit.Dashboard AI context installer
    ============================================================================
    SINGLE SOURCE, COMPILED PER EDITOR. The authored docs live in the repo's
    Instruction/extensions/<area>/ folders and are packed into each package under
    the same relative path. At consumer build time this "compiles" them into each
    detected editor's native format:

        .zonit/extensions/<area>/*.md            copied as-is (neutral, human + agent readable)
        .zonit/index.md                          generated map (anchored block)
        .cursor/rules/zonit-ext*.mdc             generated: frontmatter (globs) + doc content
        .github/instructions/zonit-ext*.md       generated: frontmatter (applyTo) + doc content
        .github/copilot-instructions.md          generated umbrella (anchored block)
        CLAUDE.md                                generated umbrella (anchored block)

    PER-PACKAGE DOC SUBSETS — the difference from the Zonit.Extensions.Ai and
    Zonit.Messaging installers. Those pack every doc into every package, so installing
    one small package dumps the whole product's documentation on the consumer. Here each
    package's own stub (Zonit.Extensions.<Name>.targets, auto-imported by NuGet) declares
    only ITS docs as <ZonitDashDoc> items and its own content folder as <ZonitDashDocRoot>.
    MSBuild imports every installed package's stub before any target runs, so this shared
    installer sees exactly the union of what the consumer actually installed:
    Cultures alone -> cultures docs; add Website -> website docs appear too.

    Because Zonit.Extensions (the value-object foundation) is a transitive dependency of
    every other package, its core docs are always present. That is intended — the VO
    contract is what every other doc builds on.

    REPO-ROOT ANCHORED. Detection and output are anchored at the workspace root (nearest
    ancestor holding .git / a solution / an editor folder), not at the building project's
    directory: in a real solution the editor folders live next to .git, several levels above
    any individual .csproj. Override with <ZonitDashInstructionsAnchor>.

    NO SPAM: a given editor's files are produced ONLY if that editor is detected at the root
    (or forced via <ZonitDashEditors>). No editor detected -> nothing is written at all.

      Editor   Detected when (at the resolved root)                Gets
      Claude   .claude/ or CLAUDE.md                               .claude/skills/ Skill + CLAUDE.md pointer
      Cursor   .cursor/                                            .cursor/rules/*.mdc
      Copilot  .vscode/ or .github/copilot-instructions.md         .github/instructions/* +
               or .github/instructions/  (NOT bare .github/ = CI)  copilot-instructions.md block

    Knobs:
      <ZonitDashEditors>auto|all|none|cursor;claude</ZonitDashEditors>   (default auto)
      <ZonitDashInstructions>false</ZonitDashInstructions>               master off switch
      <ZonitDashInstructionsRoot>.zonit</ZonitDashInstructionsRoot>      relocate the tree (under the root)
      <ZonitDashInstructionsAnchor>path</ZonitDashInstructionsAnchor>    force the workspace root explicitly

    Safety: skipped on CI (ContinuousIntegrationBuild=true) so a build server never writes
    into the working tree. Generated files are rewritten only when content actually changes,
    so this does not dirty git on every build. Umbrella blocks are injected between the
    ZONIT:dashboard START / END markers and never touch anything outside them.

    Ships in buildTransitive/ so it fires even when a package arrives transitively (e.g. the
    consumer references only Zonit.Extensions.Website and gets Auth/Cultures/… underneath).
    ============================================================================
  -->

  <!-- Import-once guard: all 8 packages ship this identical installer (each named per package
       so NuGet auto-imports it). Only the first import defines tasks and the target; the rest
       still contribute their <ZonitDashDoc>/<ZonitDashDocRoot> items from their own stubs. -->
  <PropertyGroup>
    <_ZonitDashPriorImport>$(_ZonitDashInstallerSeen)</_ZonitDashPriorImport>
    <_ZonitDashInstallerSeen>true</_ZonitDashInstallerSeen>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ZonitDashPriorImport)' != 'true'">
    <ZonitDashInstructions Condition="'$(ZonitDashInstructions)' == ''">true</ZonitDashInstructions>
    <ZonitDashInstructionsRoot Condition="'$(ZonitDashInstructionsRoot)' == ''">.zonit</ZonitDashInstructionsRoot>
    <ZonitDashEditors Condition="'$(ZonitDashEditors)' == ''">auto</ZonitDashEditors>
  </PropertyGroup>

  <!-- Resolve the workspace root by walking up to the nearest .git / solution / editor folder.
       Done in C# because MSBuild's upward-search intrinsics match files only (they miss the
       .git *directory*) and cannot loop. -->
  <UsingTask TaskName="ZonitDashFindRoot" TaskFactory="RoslynCodeTaskFactory"
             Condition="'$(_ZonitDashPriorImport)' != 'true'"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <StartDir ParameterType="System.String" Required="true" />
      <Root ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string Combine(string a, string b) { return System.IO.Path.Combine(a, b); }
        var dir = new System.IO.DirectoryInfo(StartDir);
        string repoRoot = null, editorRoot = null;
        while (dir != null)
        {
            string p = dir.FullName;
            try
            {
                if (repoRoot == null &&
                    (System.IO.Directory.Exists(Combine(p, ".git"))
                  || System.IO.File.Exists(Combine(p, ".git"))
                  || System.IO.Directory.GetFiles(p, "*.sln").Length > 0
                  || System.IO.Directory.GetFiles(p, "*.slnx").Length > 0))
                    repoRoot = p;

                if (editorRoot == null &&
                    (System.IO.Directory.Exists(Combine(p, ".claude"))
                  || System.IO.Directory.Exists(Combine(p, ".cursor"))
                  || System.IO.Directory.Exists(Combine(p, ".vscode"))
                  || System.IO.Directory.Exists(Combine(p, ".github"))
                  || System.IO.File.Exists(Combine(p, "CLAUDE.md"))))
                    editorRoot = p;
            }
            catch { /* unreadable ancestor: keep walking */ }

            if (repoRoot != null) break;  // the repo root is the definitive boundary
            dir = dir.Parent;
        }
        Root = repoRoot ?? editorRoot ?? StartDir;
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The "compiler": projects the installed docs into one editor's native files. -->
  <UsingTask TaskName="ZonitDashEmit" TaskFactory="RoslynCodeTaskFactory"
             Condition="'$(_ZonitDashPriorImport)' != 'true'"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Editor ParameterType="System.String" Required="true" />
      <Docs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ProjectRoot ParameterType="System.String" Required="true" />
      <Root ParameterType="System.String" Required="true" />
      <Changed ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        Changed = false;
        const string NL = "\n";
        const string BEGIN = "<!-- ZONIT:dashboard START -->";
        const string END = "<!-- ZONIT:dashboard END -->";

        bool WriteIfChanged(string path, string text)
        {
            string ex = System.IO.File.Exists(path) ? System.IO.File.ReadAllText(path) : null;
            if (string.Equals(ex, text, System.StringComparison.Ordinal)) return false;
            System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(path));
            System.IO.File.WriteAllText(path, text);
            return true;
        }

        bool Inject(string file, string content, string header)
        {
            string block = BEGIN + NL + content.Trim() + NL + END;
            string ex = System.IO.File.Exists(file) ? System.IO.File.ReadAllText(file) : null;
            string res;
            if (ex == null)
                res = (string.IsNullOrEmpty(header) ? "" : header.Trim() + NL + NL) + block + NL;
            else
            {
                int b = ex.IndexOf(BEGIN, System.StringComparison.Ordinal);
                int e = ex.IndexOf(END, System.StringComparison.Ordinal);
                res = (b >= 0 && e > b)
                    ? ex.Substring(0, b) + block + ex.Substring(e + END.Length)
                    : ex.TrimEnd() + NL + NL + block + NL;
            }
            return WriteIfChanged(file, res);
        }

        // Docs carry Area + Summary + optional Glob + SourceFile (the packed .md on disk).
        // Group by area so the umbrella reads as a map of the stack, not a flat pile.
        var byArea = new System.Collections.Generic.List<string>();
        var seenArea = new System.Collections.Generic.HashSet<string>(System.StringComparer.Ordinal);
        foreach (var d in Docs)
        {
            string a = d.GetMetadata("Area");
            if (seenArea.Add(a)) byArea.Add(a);
        }

        var sb = new System.Text.StringBuilder();
        sb.Append("## Zonit.Dashboard (admin UI over Zonit.Extensions.Website)" + NL + NL);
        sb.Append("This repo uses **Zonit.Dashboard**, an overlay on the Zonit.Extensions.Website kernel - " +
                  "`UseDashboard(dir, cfg)` is exactly `UseWebsite<DashboardApp, DashboardSiteOptions>(dir, cfg)`. " +
                  "Three rules that cause most mistakes:" + NL + NL);
        sb.Append("1. **Never write App.razor or Routes.razor for a dashboard mount.** Both ship inside the " +
                  "package; the shell, `<base href>`, MudBlazor assets, theme meta and `<WebsiteHydrator/>` " +
                  "are already handled. You only add pages." + NL);
        sb.Append("2. **`AddDashboard()` takes no arguments.** Per-mount config belongs to `UseDashboard`, " +
                  "because one registration can back several mounts. It calls `AddWebsite()` itself." + NL);
        sb.Append("3. **Pages are ordinary Website pages.** `@inherits PageBase`, `[RequirePermission]`, " +
                  "`[LayoutKey(\"Dashboard.Main\")]` - nothing dashboard-specific, and they never reference " +
                  "this assembly." + NL + NL);
        sb.Append("Guides:" + NL + NL);
        foreach (var area in byArea)
        {
            foreach (var d in Docs)
            {
                if (!string.Equals(d.GetMetadata("Area"), area, System.StringComparison.Ordinal)) continue;
                sb.Append("- `" + Root + "/" + area + "/" + d.ItemSpec + ".md`: " + d.GetMetadata("Summary") + NL);
            }
        }
        string umbrella = sb.ToString().Trim();

        bool ch = false;
        if (Editor == "index")
        {
            ch = Inject(System.IO.Path.Combine(ProjectRoot, Root, "index.md"), umbrella,
                "# Zonit AI assistant instructions (map)" + NL + NL +
                "> Auto-managed by Zonit packages; each library owns one anchored block.");
        }
        else if (Editor == "cursor")
        {
            string dir = System.IO.Path.Combine(ProjectRoot, ".cursor", "rules");
            ch |= WriteIfChanged(System.IO.Path.Combine(dir, "zonit-dashboard.mdc"),
                "---" + NL + "description: Zonit.Dashboard: admin UI over the Website kernel; never hand-write App.razor or Routes.razor" +
                NL + "alwaysApply: true" + NL + "---" + NL + NL + umbrella + NL);
            foreach (var d in Docs)
            {
                string glob = d.GetMetadata("Glob");
                if (string.IsNullOrEmpty(glob)) continue;
                string src = d.GetMetadata("SourceFile");
                if (!System.IO.File.Exists(src)) continue;
                string front = "---" + NL + "description: " + d.GetMetadata("Summary") + NL +
                               "globs: " + glob + NL + "alwaysApply: false" + NL + "---" + NL + NL;
                ch |= WriteIfChanged(
                    System.IO.Path.Combine(dir, "zonit-dash-" + d.GetMetadata("Area") + "-" + d.ItemSpec + ".mdc"),
                    front + System.IO.File.ReadAllText(src));
            }
        }
        else if (Editor == "copilot")
        {
            ch |= Inject(System.IO.Path.Combine(ProjectRoot, ".github", "copilot-instructions.md"),
                         umbrella, "# Copilot instructions");
            string dir = System.IO.Path.Combine(ProjectRoot, ".github", "instructions");
            foreach (var d in Docs)
            {
                string glob = d.GetMetadata("Glob");
                if (string.IsNullOrEmpty(glob)) continue;
                string src = d.GetMetadata("SourceFile");
                if (!System.IO.File.Exists(src)) continue;
                string front = "---" + NL + "applyTo: \"" + glob + "\"" + NL + "---" + NL + NL;
                ch |= WriteIfChanged(
                    System.IO.Path.Combine(dir, "zonit-dash-" + d.GetMetadata("Area") + "-" + d.ItemSpec + ".instructions.md"),
                    front + System.IO.File.ReadAllText(src));
            }
        }
        else if (Editor == "claude")
        {
            // Claude Code is the priority surface: a Skill (loaded on demand via its description)
            // plus a thin always-on CLAUDE.md pointer, so Claude knows the library exists even
            // before the skill triggers.
            string skillDesc =
                "Use when working with the Zonit admin dashboard in this .NET repo. Covers mounting it "
              + "with AddDashboard/UseDashboard, the bundled DashboardApp and Routes (never hand-write them), "
              + "the four layout keys, per-mount DashboardSiteOptions including Layout and Theme, adding "
              + "toolbar and drawer extensions, theming from tenant settings, and the trim/AOT position.";
            string skill =
                "---" + NL + "name: zonit-dashboard" + NL + "description: \"" + skillDesc + "\"" + NL + "---" + NL + NL
              + umbrella + NL;
            ch |= WriteIfChanged(
                System.IO.Path.Combine(ProjectRoot, ".claude", "skills", "zonit-dashboard", "SKILL.md"), skill);

            string pointer =
                "## Zonit.Dashboard (admin UI)" + NL + NL
              + "This repo uses **Zonit.Dashboard**, an overlay on Zonit.Extensions.Website — "
              + "`UseDashboard(dir, cfg)` is exactly `UseWebsite<DashboardApp, DashboardSiteOptions>(dir, cfg)`. "
              + "Use the **`zonit-dashboard`** skill and the guides under `" + Root + "/dashboard/`. "
              + "The rule that matters most: **never hand-write App.razor or Routes.razor for a dashboard "
              + "mount** — both ship inside the package, along with the document shell, base href, MudBlazor "
              + "assets and hydration. `AddDashboard()` takes no arguments; per-mount configuration goes to "
              + "`UseDashboard(directory, o => …)`.";
            ch |= Inject(System.IO.Path.Combine(ProjectRoot, "CLAUDE.md"), pointer,
                "# CLAUDE.md" + NL + NL + "Guidance for Claude Code in this repository.");
        }
        Changed = ch;
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ZonitDashInstallInstructions"
          AfterTargets="Build"
          Condition="'$(_ZonitDashPriorImport)' != 'true'
                     and '$(ZonitDashInstructions)' != 'false'
                     and '$(ZonitDashEditors)' != 'none'
                     and '$(ContinuousIntegrationBuild)' != 'true'
                     and '@(ZonitDashDoc)' != ''">

    <!-- 1. Resolve the workspace root (explicit anchor, else upward search). -->
    <ZonitDashFindRoot Condition="'$(ZonitDashInstructionsAnchor)' == ''" StartDir="$(MSBuildProjectDirectory)">
      <Output TaskParameter="Root" PropertyName="_ZonitDashRoot" />
    </ZonitDashFindRoot>
    <PropertyGroup>
      <_ZonitDashRoot Condition="'$(ZonitDashInstructionsAnchor)' != ''">$(ZonitDashInstructionsAnchor)</_ZonitDashRoot>
      <_ZonitDashRoot>$([MSBuild]::EnsureTrailingSlash('$(_ZonitDashRoot)'))</_ZonitDashRoot>
    </PropertyGroup>

    <!-- 2. Detect editors at that root (override | auto-detect existing editor folders). -->
    <PropertyGroup>
      <_ZonitDashClaude>false</_ZonitDashClaude>
      <_ZonitDashClaude Condition="'$(ZonitDashEditors)' == 'all'
          or ('$(ZonitDashEditors)' == 'auto' and (Exists('$(_ZonitDashRoot).claude') or Exists('$(_ZonitDashRoot)CLAUDE.md')))
          or $(ZonitDashEditors.Contains('claude'))">true</_ZonitDashClaude>

      <_ZonitDashCursor>false</_ZonitDashCursor>
      <_ZonitDashCursor Condition="'$(ZonitDashEditors)' == 'all'
          or ('$(ZonitDashEditors)' == 'auto' and Exists('$(_ZonitDashRoot).cursor'))
          or $(ZonitDashEditors.Contains('cursor'))">true</_ZonitDashCursor>

      <_ZonitDashCopilot>false</_ZonitDashCopilot>
      <_ZonitDashCopilot Condition="'$(ZonitDashEditors)' == 'all'
          or ('$(ZonitDashEditors)' == 'auto' and (Exists('$(_ZonitDashRoot).vscode') or Exists('$(_ZonitDashRoot).github\copilot-instructions.md') or Exists('$(_ZonitDashRoot).github\instructions')))
          or $(ZonitDashEditors.Contains('copilot'))">true</_ZonitDashCopilot>

      <_ZonitDashAnyEditor>false</_ZonitDashAnyEditor>
      <_ZonitDashAnyEditor Condition="'$(_ZonitDashClaude)' == 'true' or '$(_ZonitDashCursor)' == 'true' or '$(_ZonitDashCopilot)' == 'true'">true</_ZonitDashAnyEditor>
    </PropertyGroup>

    <!-- 3. Materialize the neutral tree from every installed package's content folder.
            Each <ZonitDashDocRoot> carries an Area, so the areas land side by side under
            .zonit/extensions/ without one package clobbering another. -->
    <ItemGroup Condition="'$(_ZonitDashAnyEditor)' == 'true'">
      <_ZonitDashTreeFile Include="%(ZonitDashDocRoot.FullPath)\**\*.md">
        <Area>%(ZonitDashDocRoot.Area)</Area>
      </_ZonitDashTreeFile>
    </ItemGroup>
    <Copy Condition="'$(_ZonitDashAnyEditor)' == 'true'"
          SourceFiles="@(_ZonitDashTreeFile)"
          DestinationFiles="@(_ZonitDashTreeFile->'$(_ZonitDashRoot)$(ZonitDashInstructionsRoot)\%(Area)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />

    <!-- 4. Compile the docs into each surface (index always; editors only when detected). -->
    <ZonitDashEmit Condition="'$(_ZonitDashAnyEditor)' == 'true'" Editor="index" Docs="@(ZonitDashDoc)" ProjectRoot="$(_ZonitDashRoot)" Root="$(ZonitDashInstructionsRoot)">
      <Output TaskParameter="Changed" PropertyName="_ZonitDashChIndex" />
    </ZonitDashEmit>
    <ZonitDashEmit Condition="'$(_ZonitDashCursor)' == 'true'" Editor="cursor" Docs="@(ZonitDashDoc)" ProjectRoot="$(_ZonitDashRoot)" Root="$(ZonitDashInstructionsRoot)">
      <Output TaskParameter="Changed" PropertyName="_ZonitDashChCursor" />
    </ZonitDashEmit>
    <ZonitDashEmit Condition="'$(_ZonitDashCopilot)' == 'true'" Editor="copilot" Docs="@(ZonitDashDoc)" ProjectRoot="$(_ZonitDashRoot)" Root="$(ZonitDashInstructionsRoot)">
      <Output TaskParameter="Changed" PropertyName="_ZonitDashChCopilot" />
    </ZonitDashEmit>
    <ZonitDashEmit Condition="'$(_ZonitDashClaude)' == 'true'" Editor="claude" Docs="@(ZonitDashDoc)" ProjectRoot="$(_ZonitDashRoot)" Root="$(ZonitDashInstructionsRoot)">
      <Output TaskParameter="Changed" PropertyName="_ZonitDashChClaude" />
    </ZonitDashEmit>

    <Message Importance="high"
             Condition="'$(_ZonitDashChIndex)' == 'true' or '$(_ZonitDashChCursor)' == 'true' or '$(_ZonitDashChCopilot)' == 'true' or '$(_ZonitDashChClaude)' == 'true'"
             Text="Zonit.Extensions: compiled AI instructions to '$(_ZonitDashRoot)$(ZonitDashInstructionsRoot)/dashboard/' for detected editors (Claude=$(_ZonitDashClaude), Cursor=$(_ZonitDashCursor), Copilot=$(_ZonitDashCopilot)). Override root with &lt;ZonitDashInstructionsAnchor&gt; / editors with &lt;ZonitDashEditors&gt; / disable with &lt;ZonitDashInstructions&gt;false&lt;/ZonitDashInstructions&gt;." />
  </Target>

</Project>
