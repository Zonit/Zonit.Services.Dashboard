<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- net10-only — Zonit.Extensions.Website (10.x) drops <= net9 to align with .NET LTS / preview cadence. -->
    <TargetFramework>net10.0</TargetFramework>

    <!--
      Serve this RCL's static assets from _content/ui/ instead of the default
      _content/Zonit.Dashboard/.

      The default is the assembly name, which puts the framework's name into every asset URL in
      the rendered page — the one place a stack fingerprint survives no matter how carefully the
      markup, cookies and JS globals are named. An attacker reading the HTML would otherwise know
      exactly which open-source package to go looking for advisories against.

      Consumers referencing the old path must update; the only reference in this repository is
      DashboardSiteOptions, which declares it.
    -->
    <StaticWebAssetBasePath>_content/ui</StaticWebAssetBasePath>
    <!-- Version / AssemblyVersion / FileVersion come from ../Directory.Packages.props.
         They used to be set here as well, which silently won — so the props file sat at a
         stale 0.1.63 that nothing corrected, waiting for the next project added under
         Source/ to pick it up. One source of truth. -->

    <Description>Zonit dashboard — single-project admin UI built on Zonit.Extensions.Website. Provides drawer/toolbar extension slots, dynamic theme switching, and a MudBlazor-based main layout registered into the website layout registry as "Dashboard.Main".</Description>
    <Summary>Zonit dashboard UI for AddWebsite-hosted applications.</Summary>
    <PackageTags>Zonit;Dashboard;Blazor;MudBlazor;AspNetCore;Admin</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="MudBlazor.Translations" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
  </ItemGroup>

  <!-- Local Development Mode (Zonit.Sdk workspace): ProjectReference -->
  <ItemGroup Condition="'$(IsZonitSdkWorkspace)' == 'true'">
    <!-- Zonit.Extensions.Website transitively pulls in Auth, Cultures, Organizations, Projects, Tenants. -->
    <ProjectReference Include="..\..\..\..\Extensions\Zonit.Extensions\Source\Zonit.Extensions.Website\Zonit.Extensions.Website.csproj" />
    <ProjectReference Include="..\..\..\..\Extensions\Zonit.Extensions\Source\Zonit.Extensions.Website.MudBlazor\Zonit.Extensions.Website.MudBlazor.csproj" />
    <ProjectReference Include="..\..\..\Zonit.Services.EventMessage\Source\Zonit.Messaging.Tasks.Abstractions\Zonit.Messaging.Tasks.Abstractions.csproj" />
  </ItemGroup>

  <!-- Production Mode: PackageReference -->
  <ItemGroup Condition="'$(IsZonitSdkWorkspace)' != 'true'">
    <PackageReference Include="Zonit.Extensions.Website" />
    <PackageReference Include="Zonit.Extensions.Website.MudBlazor" />
    <PackageReference Include="Zonit.Messaging.Tasks.Abstractions" />
  </ItemGroup>

</Project>
