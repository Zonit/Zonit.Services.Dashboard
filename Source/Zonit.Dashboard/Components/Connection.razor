@*
    Reconnect overlay for Blazor Server circuits. The runtime injects /
    removes the CSS classes (.components-reconnect-show / -hide / -failed /
    -rejected / -refused) automatically; this component only supplies the DOM
    shell and the styling so the indicator matches the dashboard chrome instead
    of the framework's plain default modal.

    Place once at the bottom of <body> (DashboardApp.razor). Stateless / no DI —
    every state transition is driven by the JS reconnection handler that
    blazor.web.js registers when the SignalR hub disconnects. Net 10 ships with
    a reasonable default; we override only visuals.

    Reference: aspnetcore docs "Reconnect to the same server" + Blazor source
    (Components/Web.JS/src/Boot.Server.Common.ts).
*@
@namespace Zonit.Dashboard.Components

<div id="components-reconnect-modal" class="reconnect-modal">
    <div class="reconnect-content">
        <div class="reconnect-spinner" aria-hidden="true"></div>
        <div class="reconnect-title" data-reconnect-state="show">Reconnecting...</div>
        <div class="reconnect-title" data-reconnect-state="failed">Reconnection failed</div>
        <div class="reconnect-title" data-reconnect-state="rejected">Connection rejected</div>
        <div class="reconnect-actions">
            <a href="" class="reconnect-button">Reload page</a>
        </div>
    </div>
</div>

<style>
    /* The framework only sets classes on #components-reconnect-modal; we map
       them to dedicated visual states. Default = hidden so a fresh page never
       flashes the modal. */
    #components-reconnect-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        z-index: 1100;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(2px);
    }
    #components-reconnect-modal.components-reconnect-show,
    #components-reconnect-modal.components-reconnect-failed,
    #components-reconnect-modal.components-reconnect-rejected,
    #components-reconnect-modal.components-reconnect-refused {
        display: flex;
    }

    .reconnect-content {
        background: var(--mud-palette-surface, #ffffff);
        color: var(--mud-palette-text-primary, #1f2937);
        border-radius: 12px;
        padding: 32px;
        min-width: 320px;
        max-width: 480px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
        text-align: center;
    }
    .reconnect-spinner {
        width: 48px;
        height: 48px;
        margin: 0 auto 16px;
        border-radius: 50%;
        border: 3px solid var(--mud-palette-divider, rgba(0,0,0,0.12));
        border-top-color: var(--mud-palette-primary, #7764e5);
        animation: reconnect-spin 0.9s linear infinite;
    }
    @@keyframes reconnect-spin {
        to { transform: rotate(360deg); }
    }
    .reconnect-title {
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 8px;
        display: none;
    }
    /* Per-state visibility — show the matching label, hide the others. */
    #components-reconnect-modal.components-reconnect-show .reconnect-title[data-reconnect-state="show"] { display: block; }
    #components-reconnect-modal.components-reconnect-failed .reconnect-title[data-reconnect-state="failed"] { display: block; }
    #components-reconnect-modal.components-reconnect-rejected .reconnect-title[data-reconnect-state="rejected"],
    #components-reconnect-modal.components-reconnect-refused .reconnect-title[data-reconnect-state="rejected"] { display: block; }

    /* Actions only matter once auto-reconnect has actually given up. The "show"
       state still has the spinner running, so a Reload button there would race
       the framework's own retry. */
    .reconnect-actions { display: none; }
    #components-reconnect-modal.components-reconnect-failed .reconnect-actions,
    #components-reconnect-modal.components-reconnect-rejected .reconnect-actions,
    #components-reconnect-modal.components-reconnect-refused .reconnect-actions {
        display: block;
        margin-top: 12px;
    }
    .reconnect-button {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 8px;
        background: var(--mud-palette-primary, #7764e5);
        color: #ffffff;
        text-decoration: none;
        font-weight: 600;
    }
    .reconnect-button:hover {
        filter: brightness(1.1);
    }
</style>
