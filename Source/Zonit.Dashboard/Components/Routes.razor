@*
    Dashboard router. Identical structure to Example's Routes.razor but pulls page
    assemblies from WebsiteAreaRegistry (no hard-coded typeof(SomeArea).Assembly list)
    so a host can mount any plug-in area in a dashboard without editing this file.

    Why the singleton registry instead of scoped ICurrentSite.Areas:
    Routes is rendered with @rendermode="InteractiveServer", so after the SSR
    prerender pass it hydrates inside a SignalR circuit scope. That scope NEVER
    runs the per-Site branch middleware (current.Set(site)) — UseWebsite's
    branch.Use(...) only fires for HTTP requests, not circuit lifecycle. Reading
    ICurrentSite.Areas from the circuit therefore returns the unset default
    (IsSet=false, Areas=Array.Empty), the Router gets zero AdditionalAssemblies,
    and every cross-assembly @page is "Not Found" the moment the page goes
    interactive — even though the same URL renders fine on the SSR pass.
    WebsiteAreaRegistry is a singleton populated at AddWebsite() time, so it
    survives the HTTP-scope-to-circuit-scope transition cleanly.

    ZonitRouteView honours [LayoutKey] / [NoLayout] / runtime ILayoutContext, so
    plug-in pages can @attribute [LayoutKey("Dashboard.Main")] without taking a
    project reference on Zonit.Dashboard.
*@
@namespace Zonit.Dashboard.Components
@using Microsoft.AspNetCore.Components.Routing
@using Zonit.Dashboard.Components.Layouts
@using Zonit.Extensions.Website
@using Zonit.Extensions.Website.Layouts.Components

@inject DashboardMountRegistry Mounts
@inject NavigationManager Nav

<Router AppAssembly="@typeof(DashboardApp).Assembly"
        AdditionalAssemblies="@AreaAssemblies">
    <Found Context="routeData">
        <ZonitRouteView RouteData="@routeData"
                        DefaultLayout="@typeof(DashboardMainLayout)">
            <NotAuthorized>
                <LayoutView Layout="@typeof(DashboardMinimalLayout)">
                    <PageTitle>Not authorized</PageTitle>
                    <MudPaper Class="pa-8" Elevation="0">
                        <MudText Typo="Typo.h2" Color="MudBlazor.Color.Error" Align="MudBlazor.Align.Center">403</MudText>
                        <MudText Typo="Typo.h5" Align="MudBlazor.Align.Center" Class="mt-2">Not authorized</MudText>
                        <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Class="mt-4">
                            You need additional roles or permissions to view this page.
                        </MudText>
                    </MudPaper>
                </LayoutView>
            </NotAuthorized>
        </ZonitRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    @* Router doesn't ship a <NotFound> slot for static SSR, but the routable
       NotFound.razor page (@page "/404") covers direct navigation. Unmatched
       runtime routes redirect there via PageBase's interactive handler. *@
</Router>

@code {
    // Resolve the active mount from NavigationManager.BaseUri — it's available in
    // BOTH the SSR HTTP scope and the interactive SignalR circuit scope, unlike
    // ICurrentSite.Directory which is only populated by per-Site branch middleware
    // (the circuit lifecycle does not pass through branch.Use(...)). For a
    // dashboard mounted at "/admin", BaseUri is "https://host/admin/", and
    // new Uri(BaseUri).AbsolutePath gives "/admin/" — TrimEnd inside the registry
    // makes it match the normalised "/admin" key set by UseDashboard.
    //
    // Distinct because the same plug-in may live in the same assembly as another;
    // Router rejects duplicate assemblies with "Assembly already defined".
    IEnumerable<System.Reflection.Assembly> AreaAssemblies
        => Mounts.ForMount(new Uri(Nav.BaseUri).AbsolutePath)
            .Where(a => a != typeof(DashboardApp).Assembly)
            .Distinct();
}
