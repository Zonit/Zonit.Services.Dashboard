@*
    Dashboard-specific head content, contributed to AppBase through
    DocumentOptions.AddHeadComponent<DashboardHead>() in DashboardSiteOptions.

    Everything structural — charset, viewport, <base href>, stylesheets, the scoped-CSS bundle,
    ImportMap, HeadOutlet — is emitted by AppBase. What remains here is what only the dashboard
    knows: the tenant's brand colour, the server-rendered colour scheme, the zero-flicker
    handshake that MudBlazor's server-side theming needs, the tenant favicon, and the consumer's
    custom snippet.

    No <title> here on purpose. PageHead emits it through HeadOutlet for every routed page,
    already composed with the tenant's website title — a raw <title> in this component would
    render earlier in the document and win, permanently freezing every page on the site name.
*@
@namespace Zonit.Dashboard.Components
@using Zonit.Extensions.Tenants

@inject ITenantProvider Tenant
@inject IDashboardCurrentSite Dashboard
@inject Zonit.Dashboard.Themes.IThemeManager ThemeManager

<meta name="color-scheme" content="@(ThemeManager.IsDark ? "dark" : "light")" />

@* Zero-flicker dark-mode handshake. Runs BEFORE Blazor boots:
     1. Detects prefers-color-scheme.
     2. Stamps the result into a cookie so the next SSR can render the matching palette without
        a round-trip to JS (no flash-of-light).
     3. Paints a matching background on <html> immediately so the browser does not show its
        default white between the first byte and MudBlazor's CSS loading. Once MudThemeProvider
        mounts it owns the palette and the inline style is overridden cleanly.

   This is deliberately NOT the framework's AppearanceScript. That one is purely client-side and
   keeps the HTML identical for every visitor, which is what makes a public site cacheable.
   MudThemeProvider resolves its palette on the SERVER, so the dashboard has to tell the server
   what the visitor's system preference is — hence the cookie. The dashboard is behind a login
   and never cached, so it pays nothing for that. *@
<script>
    (function () {
        try {
            var prefersDark = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            var cookie = function (n) { return (document.cookie.match(new RegExp('(?:^|; )' + n + '=([^;]*)')) || [])[1]; };

            var mode = cookie('ui\\.mode');
            var seen = cookie('ui\\.scheme');
            var actual = prefersDark ? '1' : '0';

            if (seen !== actual) {
                document.cookie = 'ui.scheme=' + actual + '; path=/; max-age=31536000; SameSite=Lax';
            }

            //  The server resolves Auto from ui.scheme, and this script is the only thing that
            //  writes it — which means the server is always working from the PREVIOUS visit's
            //  answer. Measured both ways: with a stale ui.scheme=1 and the system now light, the
            //  server emitted the dark palette and the circuit then repainted light; on a first
            //  visit with no cookie at all and a dark system, it emitted light and repainted dark.
            //  That repaint is the flash — dark for a moment, then light.
            //
            //  Only Auto is affected. An explicit Light or Dark needs no system answer, so the
            //  server already had everything it needed and nothing below runs.
            //
            //  Reloading here costs one round-trip on the rare load where the system preference
            //  actually changed (or the very first visit), and it happens BEFORE first paint, so
            //  there is nothing on screen to flash. replace() rather than assign() keeps it out of
            //  session history — the back button must not walk through it.
            if (mode !== 'Dark' && mode !== 'Light' && seen !== actual) {
                window.location.replace(window.location.href);
                return;
            }

            //  First paint, before any stylesheet has loaded. Values track the themes' own
            //  Background slots; they were left behind on an older palette and painted #161723
            //  under a page whose real background had moved to #0a0d12.
            var isDark = mode === 'Dark' || (mode !== 'Light' && prefersDark);
            document.documentElement.style.backgroundColor = isDark ? '#0a0d12' : '#f4f6fa';
            document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
        } catch (e) { /* failures here must never block render */ }
    })();
</script>

@if (!string.IsNullOrWhiteSpace(Tenant.Settings.Site.FaviconUrl))
{
    <link rel="icon" type="image/svg+xml" href="@(Tenant.Settings.Site.FaviconUrl)" />
}

@if (!string.IsNullOrWhiteSpace(Dashboard.CustomSnippet))
{
    @((MarkupString)Dashboard.CustomSnippet!)
}
