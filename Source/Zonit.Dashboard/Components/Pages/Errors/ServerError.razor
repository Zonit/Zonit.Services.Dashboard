@*
    HTTP 500 — Internal Server Error. Reached via the framework's
    UseExceptionHandler pipeline (default ExceptionHandlerPath = "/error" →
    re-executes "/error/500" via UseStatusCodePagesWithReExecute).
*@
@page "/500"
@page "/error"
@page "/error/500"
@attribute [LayoutKey("Zonit.Minimal")]
@attribute [AllowAnonymous]
@inherits PageBase
@namespace Zonit.Dashboard.Components.Pages.Errors
@using Microsoft.AspNetCore.Authorization
@using Zonit.Extensions.Website

@inject NavigationManager Nav

<ErrorPanel Status="500"
            Color="MudBlazor.Color.Error"
            Headline="Internal server error"
            Description="Something went wrong on our end. The error has been logged.">
    <Actions>
        @*
            forceLoad, because the point of Retry on a 500 is to redo the REQUEST. An enhanced
            navigation to the same URL would re-render inside the circuit that just failed, which
            reproduces the error rather than retrying it.

            This is the one error-page action that genuinely needs interactivity — there is no href
            that means "do that again" — so it stays an OnClick and the Home button beside it stays
            a plain link, which is what still works when the circuit is the thing that broke.
        *@
        <MudButton Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="@(() => Nav.NavigateTo(Nav.Uri, forceLoad: true))">
            @Culture.Translate("Retry")
        </MudButton>
    </Actions>
</ErrorPanel>

@code {
    // Metadata through PageBase, not a raw <PageTitle>.
    //
    // A <PageTitle> writes the document title directly and bypasses everything the website
    // kernel composes around it. Measured: these pages produced a bare "Sign in" / "Page not
    // found" while a framework page on the same site produced
    // "Cultures — overview - Zonit.Extensions Demo" — the tenant name silently missing from
    // every built-in screen.
    //
    // NoIndex is stated per page rather than inherited from the mount, because
    // DashboardSiteOptions.Indexable is a switch a host is allowed to turn on, and a
    // deliberately public dashboard must still never put its login screen or its error pages
    // into a search index.
    protected override PageMeta Metadata => new() { Title = "Internal server error", NoIndex = true };
}
