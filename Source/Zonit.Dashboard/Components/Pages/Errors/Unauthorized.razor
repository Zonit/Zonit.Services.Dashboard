@*
    HTTP 401 — Unauthorized. Reached via direct navigation OR the framework's
    UseStatusCodePagesWithReExecute pipeline (configured in SiteOptions.ExceptionHandlerPath,
    default "/error" → "/error/401").
*@
@page "/401"
@page "/error/401"
@attribute [LayoutKey("Zonit.Minimal")]
@attribute [AllowAnonymous]
@inherits PageBase
@namespace Zonit.Dashboard.Components.Pages.Errors
@using Microsoft.AspNetCore.Authorization
@using Zonit.Extensions.Website

@inject NavigationManager Nav
@inject IDashboardCurrentSite Site

<ErrorPanel Status="401"
            Color="MudBlazor.Color.Warning"
            Headline="Unauthorized"
            Description="You need to sign in to access this page.">
    <Actions>
        @if (Site.Identity.LoginPage is { Length: > 0 })
        {
        @*
            Carries the page the visitor was refused, so signing in returns them there instead of
            dumping them on the dashboard root to find it again. LoginHref validates nothing itself
            — the endpoint discards any returnUrl that is not a path inside this mount, which is
            what stops this from being an open redirect.
        *@
        <MudButton Href="@LoginHref" Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary"
                   StartIcon="@Icons.Material.Filled.Login">
            @Culture.Translate("Sign in")
        </MudButton>
        }
    </Actions>
</ErrorPanel>

@code {
    // Metadata through PageBase, not a raw <PageTitle>.
    //
    // A <PageTitle> writes the document title directly and bypasses everything the website
    // kernel composes around it. Measured: these pages produced a bare "Sign in" / "Page not
    // found" while a framework page on the same site produced
    // "Cultures — overview - Zonit.Extensions Demo" — the tenant name silently missing from
    // every built-in screen.
    //
    // NoIndex is stated per page rather than inherited from the mount, because
    // DashboardSiteOptions.Indexable is a switch a host is allowed to turn on, and a
    // deliberately public dashboard must still never put its login screen or its error pages
    // into a search index.
    protected override PageMeta Metadata => new() { Title = "Unauthorized", NoIndex = true };
    private string LoginHref
    {
        get
        {
            // Absolute path of wherever they were, relative to the host — the shape the endpoint's
            // Safe() check expects.
            var current = new Uri(Nav.Uri).AbsolutePath;
            return $"{Site.Identity.LoginPage}?returnUrl={Uri.EscapeDataString(current)}";
        }
    }
}
