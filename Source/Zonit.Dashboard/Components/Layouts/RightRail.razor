@*
    Persistent right-side rail. Restores the legacy Zonit.Services.Dashboard UX
    where the user-settings column lived as a permanently visible drawer with
    inline labelled switchers (avatar + "Theme · Auto", "Organization · Acme", ...).
    The rail itself doesn't host the picker UI — clicking a row toggles the matching
    drawer extension (zonit.dashboard.theme / .workspace / .project / .culture).
    Reusing the existing drawer panels keeps a single source of truth for the actual
    switching logic.

    The Account row is the exception and navigates instead: the profile is a TOOLBAR
    extension, not a drawer one, so there is no panel for it to open. This file used to
    claim otherwise and toggled an id that GetDrawer could never resolve — see the
    comment on the row itself.

    Hard-coded for now per request — future "blocks" iteration will expose this
    as a plug-in slot in Zonit.Extensions.Website so non-dashboard hosts can
    drop in their own rail items.
*@
@namespace Zonit.Dashboard.Components.Layouts
@using Microsoft.AspNetCore.Components.Authorization
@using Zonit.Dashboard.Extensions
@using Zonit.Dashboard.Themes
@using Zonit.Extensions
@using Zonit.Extensions.Auth
@using Zonit.Extensions.Cultures
@using Zonit.Extensions.Organizations
@using Zonit.Extensions.Projects
@implements IDisposable

@inject ICultureProvider Culture
@inject ICultureState CultureState
@inject IAuthenticatedProvider Authenticated
@inject IWorkspaceProvider Workspace
@inject ICatalogProvider Catalog
@inject IThemeManager ThemeManager
@inject IExtensionDrawerStates DrawerStates
@inject NavigationManager Nav
@inject IDashboardCurrentSite Site

<MudStack Spacing="0" Class="py-2">

    @*
        ─── User profile ───
        Both branches are gated on the host having configured a page. A host on external SSO may
        have no login page of its own here at all, and a labelled button that navigates to a 404
        is the defect this whole file keeps running into.
    *@
    @if (Authenticated.Current.HasValue && Site.Identity.ProfilePage is { Length: > 0 })
    {
        var user = Authenticated.Current;
        var name = user.Name.ToString();
        var initial = !string.IsNullOrWhiteSpace(name)
            ? name![..1].ToUpperInvariant()
            : "?";

        @*
            Navigates, and does NOT toggle a drawer. It used to call
            Toggle("zonit.dashboard.user-profile") — an id that belongs to a TOOLBAR extension, so
            ExtensionRegistry.GetDrawer never resolved it, GetState returned null and Toggle()
            silently did nothing. The most prominent control in the rail, and the first thing a
            phone user reaches behind the settings button, was inert for every signed-in visitor.
        *@
        <RailButton TooltipText="@T("Profile")"
                    OnClick="@(() => Nav.NavigateTo(Site.Identity.ProfilePage!))">
            <LeadingTemplate>
                <MudAvatar Color="MudBlazor.Color.Primary" Size="Size.Small">@initial</MudAvatar>
            </LeadingTemplate>
            <Label>@T("Account")</Label>
            <Value>@name</Value>
        </RailButton>
    }
    else if (!Authenticated.Current.HasValue && Site.Identity.LoginPage is { Length: > 0 })
    {
        <RailButton TooltipText="@T("Sign in")"
                    OnClick="@(() => Nav.NavigateTo(Site.Identity.LoginPage!))">
            <LeadingTemplate>
                <MudIcon Icon="@Icons.Material.Filled.Login" Color="MudBlazor.Color.Default" Size="Size.Small" />
            </LeadingTemplate>
            <Label>@T("Account")</Label>
            <Value>@T("Sign in")</Value>
        </RailButton>
    }

    <MudDivider Class="my-1" />

    @* ─── Theme ───
         Gated like the two rows below it. ExtensionsWhitelist genuinely can remove the theme
         drawer, and an ungated row in that configuration is a labelled button that does nothing —
         Toggle() resolves through the same nullable GetState and no-ops. *@
    @if (HasExtension(ThemeId))
    {
        <RailButton TooltipText="@T("Change theme")"
                    OnClick="@(() => Toggle(ThemeId))">
            <LeadingTemplate>
                <MudIcon Icon="@ThemeIcon" Color="MudBlazor.Color.Default" Size="Size.Small" />
            </LeadingTemplate>
            <Label>@T("Theme")</Label>
            <Value>@ThemeLabel</Value>
        </RailButton>

        <MudDivider Class="my-1" />
    }

    @*
        ─── Organization ───
        The row is gated on the SWITCHER being registered, not on an organization being
        selected. Gating on the value is what made the dashboard look like it had lost the
        org and project pickers entirely: a visitor who has not joined an organization yet —
        or is not signed in — saw no row at all, so there was no way to discover that
        switching is even possible. An empty row states the situation and still opens the
        picker; a missing row states nothing.
    *@
    @if (HasExtension(WorkspaceId))
    {
        var hasOrg = Workspace.Organization.HasValue;
        var orgName = !hasOrg
            ? T("Not selected")
            : Workspace.Organization.Name.HasValue
                ? Workspace.Organization.Name.Value
                : Workspace.Organization.Id.ToString();

        <RailButton TooltipText="@T("Change organization")"
                    OnClick="@(() => Toggle(WorkspaceId))">
            <LeadingTemplate>
                @*
                    An avatar only when there is something to put in it. The empty state used to
                    render an em dash inside a filled square, which is a strong graphic mark
                    standing for "nothing here" — it read as a broken image, and it sat in the
                    same column as the user's real initial. An outline icon says "no organization"
                    without claiming to be one.
                *@
                @if (hasOrg)
                {
                    <MudAvatar Color="MudBlazor.Color.Primary" Size="Size.Small">
                        @(orgName.Length > 0 ? orgName[..1].ToUpperInvariant() : "?")
                    </MudAvatar>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Business" Color="MudBlazor.Color.Default" Size="Size.Small" />
                }
            </LeadingTemplate>
            <Label>@T("Organization")</Label>
            <Value>@orgName</Value>
        </RailButton>

        <MudDivider Class="my-1" />
    }

    @* ─── Project ─── *@
    @if (HasExtension(ProjectId))
    {
        var hasProject = Catalog.Project.HasValue;
        var projectName = !hasProject
            ? T("Not selected")
            : Catalog.Project.Name.HasValue
                ? Catalog.Project.Name.Value
                : Catalog.Project.Id.ToString();

        <RailButton TooltipText="@T("Change project")"
                    OnClick="@(() => Toggle(ProjectId))">
            <LeadingTemplate>
                <MudIcon Icon="@(hasProject ? Icons.Material.Filled.Folder : Icons.Material.Outlined.Folder)"
                         Color="MudBlazor.Color.Default" Size="Size.Small" />
            </LeadingTemplate>
            <Label>@T("Project")</Label>
            <Value>@projectName</Value>
        </RailButton>

        <MudDivider Class="my-1" />
    }

    @* ─── Culture ─── *@
    @if (HasExtension(CultureId))
    {
        <RailButton TooltipText="@T("Change language")"
                    OnClick="@(() => Toggle(CultureId))">
            <LeadingTemplate>
                @*
                    The language's own flag, when the host registered a model for it. Falls back to the
                    generic globe — a host may support a culture the Cultures package has no model for,
                    and an empty slot would misalign this row against the four above it.
                *@
                @if (CurrentLanguage is { IconFlag.Length: > 0 } flagged)
                {
                    <span class="zpanel-flag">@((MarkupString)flagged.IconFlag)</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Language" Color="MudBlazor.Color.Default" Size="Size.Small" />
                }
            </LeadingTemplate>
            <Label>@T("Language")</Label>
            <Value>@LanguageLabel</Value>
        </RailButton>
    }

</MudStack>

@code {
    // Stable extension IDs — must match the Id properties on each builtin
    // *DrawerExtension. Hard-coded constants here are intentional: any rename
    // breaks the rail's contract with the drawer system in exactly one place
    // (this file), so it surfaces immediately during code review.
    private const string ThemeId       = "zonit.dashboard.theme";
    private const string WorkspaceId   = "zonit.dashboard.workspace";
    private const string ProjectId     = "zonit.dashboard.project";
    private const string CultureId     = "zonit.dashboard.culture";

    private string ThemeIcon => ThemeManager.Mode switch
    {
        ThemeMode.Dark  => Icons.Material.Filled.DarkMode,
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        _               => Icons.Material.Filled.BrightnessAuto,
    };

    private string ThemeLabel => ThemeManager.Mode switch
    {
        ThemeMode.Dark  => T("Dark"),
        ThemeMode.Light => T("Light"),
        _               => T("Auto"),
    };

    /// <summary>The registered model for the active culture, or null when the host has none.</summary>
    private LanguageModel? CurrentLanguage
    {
        get
        {
            if (!Culture.Current.HasValue) return null;
            var code = Culture.Current.ValueOrDefault;

            foreach (var lang in CultureState.Supported)
                if (string.Equals(lang.Code, code, StringComparison.OrdinalIgnoreCase))
                    return lang;

            return null;
        }
    }

    /// <summary>
    /// The language's name, not its tag.
    /// </summary>
    /// <remarks>
    /// <para>This row printed <c>Culture.Current.ValueOrDefault.ToUpperInvariant()</c> — literally
    /// "PL-PL", "EN-US". A BCP-47 tag is an identifier for the machine; the person reading the rail
    /// wants to know they are looking at a Polish interface. Every supported language already
    /// carries <c>EnglishName</c> and <c>NativeName</c> for exactly this.</para>
    ///
    /// <para>English name, run through the translator, is the right choice over
    /// <c>NativeName</c>: the whole rail is rendered in the visitor's active language, so a
    /// row that suddenly says "Deutsch" in an otherwise Polish column is the odd one out. The
    /// native name belongs in the picker, where the visitor is choosing a language they may not
    /// currently read — and that is where the panel puts it.</para>
    ///
    /// <para>Falls back to the upper-cased tag when the host supports a culture the Cultures
    /// package has no model for: a tag is poor, but it is better than an empty row.</para>
    /// </remarks>
    private string LanguageLabel
    {
        get
        {
            if (CurrentLanguage is { } lang)
                return T(lang.EnglishName);

            return Culture.Current.HasValue
                ? Culture.Current.ValueOrDefault.ToUpperInvariant()
                : T("Auto");
        }
    }

    protected override void OnInitialized()
    {
        Culture.OnChange      += OnChange;
        Authenticated.OnChange += OnChange;
        Workspace.OnChange    += OnChange;
        Catalog.OnChange      += OnChange;
        ThemeManager.OnChange += OnChange;
        DrawerStates.OnChange += OnChange;
    }

    private void OnChange() => InvokeAsync(StateHasChanged);

    private void Toggle(string extensionId)
        => DrawerStates.GetState(extensionId)?.Toggle();

    // A null state means the host never registered that drawer extension, so there is
    // genuinely nothing to switch — a dashboard with no Projects area should not grow a
    // dead "Project" row. This is the honest version of the check the value-gating was
    // standing in for.
    private bool HasExtension(string extensionId)
        => DrawerStates.GetState(extensionId) is not null;

    private string T(string key) => Culture.Translate(key).ToString() ?? key;

    public void Dispose()
    {
        Culture.OnChange      -= OnChange;
        Authenticated.OnChange -= OnChange;
        Workspace.OnChange    -= OnChange;
        Catalog.OnChange      -= OnChange;
        ThemeManager.OnChange -= OnChange;
        DrawerStates.OnChange -= OnChange;
    }
}
