@*
    Recursive renderer for one NavGroup. A component IS the recursion point — Razor has no
    recursive @code-block helper.

    Plain HTML + CSS rather than MudNavGroup/MudNavLink, for two reasons that are not cosmetic:

      * <details>/<summary> expands and collapses with NO JavaScript and NO Blazor circuit, so
        navigation is fully usable during SSR and on a page that never goes interactive.
        MudNavGroup keeps its open state in component state and therefore needs the circuit.
      * <nav>/<ul>/<li>/<a> is what a screen reader expects. The previous tree emitted nested
        divs with no list semantics and wrapped every link in a tooltip element even when there
        was no tooltip to show.

    Leaf rows delegate to RenderNavItem, which recurses through NavItem.Children — the level
    this renderer used to drop on the floor.

    Active styling comes from Blazor's own NavLink, which writes .active for us. Ancestor
    expansion does NOT: NavLink only knows about itself, so NavTree answers "is the active page
    somewhere below me" for every branch.
*@
@namespace Zonit.Dashboard.Components.Layouts
@using Microsoft.AspNetCore.Components.Routing
@using Zonit.Extensions.Website

@if (HasChildren)
{
    <li>
        @* open = author's default OR "the visitor is standing inside this section". The second
           term is what keeps a deep tree navigable: without it, following a link three levels
           down renders its whole ancestry collapsed and the sidebar stops showing where you are. *@
        <details class="znav-group" open="@IsOpen">
            <summary aria-disabled="@(Group.Disabled ? "true" : null)" title="@Group.Tooltip">
                <NavIcon Icon="@Group.Icon" Reserve="@ReserveIcon" />
                <span class="znav-label">@Group.Title.Value</span>
                @if (!string.IsNullOrEmpty(Group.Badge))
                {
                    <span class="znav-badge @NavRender.BadgeClass(Group.BadgeColor)">@Group.Badge</span>
                }
                <svg class="znav-chevron" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </summary>

            @* One reservation decision for the whole list — items and sub-groups share the
               column, so they have to agree on whether it exists. *@
            @{ var listHasIcons = NavRender.AnyIcon(Group.Children) || NavRender.AnyIcon(Group.Groups); }
            <ul class="znav-children" data-depth="@DepthAttr">
                @if (Group.Children is not null)
                {
                    @foreach (var item in Group.Children.OrderBy(c => c.Order))
                    {
                        <RenderNavItem Item="@item" Depth="@(Depth + 1)" CurrentPath="@Current"
                                       ReserveIcon="@listHasIcons" />
                    }
                }

                @if (Group.Groups is not null)
                {
                    @foreach (var sub in Group.Groups.OrderBy(g => g.Order))
                    {
                        <RenderNavGroup Group="@sub" Depth="@(Depth + 1)" ReserveIcon="@listHasIcons" />
                    }
                }
            </ul>
        </details>
    </li>
}
else if (Group.Link is not null)
{
    @* Header-only group: one link, no disclosure. *@
    <li>
        <NavLink class="znav-link" href="@Group.Link.Url.ToHref()" Match="NavLinkMatch.Prefix"
                 aria-disabled="@(Group.Disabled ? "true" : null)" title="@Group.Tooltip">
            <NavIcon Icon="@Group.Icon" Reserve="@ReserveIcon" />
            <span class="znav-label">@Group.Title.Value</span>
            @if (!string.IsNullOrEmpty(Group.Badge))
            {
                <span class="znav-badge @NavRender.BadgeClass(Group.BadgeColor)">@Group.Badge</span>
            }
        </NavLink>
    </li>
}
else
{
    @* Neither children nor a link: a section caption. *@
    <li class="znav-section-label">@Group.Title.Value</li>
}

@code {
    [Parameter, EditorRequired]
    public NavGroup Group { get; set; } = default!;

    /// <summary>Nesting level; 0 is a top-level group.</summary>
    [Parameter]
    public int Depth { get; set; }

    /// <summary>Set by the parent list when at least one sibling declares an icon.</summary>
    [Parameter]
    public bool ReserveIcon { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string Current => NavTree.CurrentPath(Navigation);

    private bool HasChildren =>
        Group.Children is { Count: > 0 } || Group.Groups is { Count: > 0 };

    private bool IsOpen => Group.Expanded || NavTree.ContainsActive(Group, Current);

    // Capped so the stylesheet has a finite set of indentation steps; see RenderNavItem.
    private string DepthAttr => Math.Min(Depth + 1, 4).ToString();
}
