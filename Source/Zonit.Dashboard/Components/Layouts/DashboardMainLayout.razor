@*
    Full dashboard chrome — registered as "Dashboard.Main" in ILayoutRegistry so
    plug-in pages opt-in with @attribute [LayoutKey("Dashboard.Main")] without
    referencing this assembly.

    Composition (top → bottom):
      <MudThemeProvider>          IThemeManager.Current.MudTheme + IsDark
      <MudPopover/Dialog/Snackbar>
      <MudLayout>
        <MudAppBar>               toolbar Start / Center / End slots + drawer toggles
        <MudDrawer Anchor=Start>  navigation aggregated from every mounted IWebsiteArea
        <MudDrawer Anchor=End>    one per drawer extension (single-active-per-anchor policy)
        <MudMainContent>          breadcrumbs + @Body

    All state-change subscriptions live in DashboardMainLayout.razor.cs.
*@
@inherits LayoutComponentBase
@namespace Zonit.Dashboard.Components.Layouts
@using Microsoft.AspNetCore.Components.Authorization
@using Zonit.Dashboard.Extensions
@using Zonit.Dashboard.Themes
@using Zonit.Extensions.Tenants
@using Zonit.Extensions.Website

@* Providers + the <html> background / color-scheme sync. Shared with the minimal and empty
   layouts so a new layout cannot silently ship without a theme. *@
<DashboardThemeRoot />

<MudRTLProvider RightToLeft="@IsRtl">
<MudSwipeArea OnSwipeEnd="@OnSwipe" Style="width: 100%; touch-action: pan-y" PreventDefault="false">
<MudLayout>

    @if (Site.Layout.ShowProgressBar && ProgressBarVisible)
    {
        <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" Size="Size.Small" Style="position: absolute; top: 0; left: 0; right: 0; z-index: 2;" />
    }

    @* Class="zbar" scopes the appbar rules in zonit-dashboard.css — chiefly "the brand
       truncates instead of wrapping", which is what turned the phone header into two
       stacked lines of title with the icons pushed off the row. *@
    <MudAppBar Elevation="@Site.Layout.AppbarElevation" Dense="true" Class="zbar">
        @* ─── Start slot: hamburger + brand + toolbar START extensions ─── *@
        @if (Site.Layout.ShowLeftDrawer)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="MudBlazor.Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@ToggleLeftDrawer"
                           aria-label="@Culture.Translate("Toggle navigation").Value" />
        }

        @* The brand renders HERE AND NOWHERE ELSE. It used to appear twice — once in this
           bar and once in the drawer header directly beneath it — which on a narrow window
           read as the site name printed twice, one under the other. The appbar is the copy
           that survives because it is the only one visible at every width: the drawer is
           closed on phones.

           Empty Href => relative to <base href>, so on a dashboard mounted at "/docs" this
           lands on "/docs/", NOT the host root. An absolute "/" would dump the visitor onto
           the wrong site entirely — the same path-base bypass ToHref() exists to prevent. *@
        <MudLink Href="" Underline="Underline.None" Color="MudBlazor.Color.Inherit" Class="zbar-brand ml-2">
            <MudText Typo="Typo.h6" Class="zbar-brand-text">@Tenant.Settings.Site.Title</MudText>
        </MudLink>

        @foreach (var ext in ToolbarStartExtensions)
        {
            @ext.CreateToolbarContent()
        }

        @* Center / End spacing *@
        <MudSpacer />

        @foreach (var ext in ToolbarCenterExtensions)
        {
            @ext.CreateToolbarContent()
        }

        <MudSpacer />

        @* ─── End slot: toolbar END extensions + right-hand affordance ─── *@
        @foreach (var ext in ToolbarEndExtensions)
        {
            @ext.CreateToolbarContent()
        }

        @if (Site.Layout.ShowRightRail)
        {
            @* One button, not one per extension. Previously every right-anchored drawer
               extension (theme, workspace, project, culture, profile) added its own bare
               icon here as soon as the rail was hidden — five unlabelled glyphs competing
               with the title for a phone's 400px of header. They all still exist, as
               labelled rows, one tap deeper inside the rail. Desktop hides the button
               entirely because the rail is already on screen. *@
            @if (!_railIsPersistent)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Tune"
                               Color="MudBlazor.Color.Inherit"
                               Edge="Edge.End"
                               OnClick="@ToggleRightRail"
                               aria-label="@Culture.Translate("Open settings").Value" />
            }
        }
        else if (Site.Layout.ShowRightDrawer)
        {
            @* No rail configured, so the extensions have nowhere else to live. *@
            @foreach (var ext in RightAnchorDrawerExtensions)
            {
                <MudTooltip Text="@ext.Name">
                    <MudIconButton Icon="@(ext.Icon ?? Icons.Material.Filled.MoreVert)"
                                   Color="MudBlazor.Color.Inherit"
                                   OnClick="@(() => ToggleDrawerExtension(ext.Id))"
                                   aria-label="@ext.Name" />
                </MudTooltip>
            }
        }
    </MudAppBar>

    @* ─── Left drawer: aggregated navigation from every mounted area ─── *@
    @if (Site.Layout.ShowLeftDrawer)
    {
        @* DrawerVariant.Mini is deliberately NOT used any more. Mini collapses the drawer to
           a 56px icon rail, and MudBlazor's mini stylesheet knows how to fold MudNavMenu's
           markup into that width — it has no idea what to do with ours. The result on every
           phone wider than 425px (an iPhone Pro Max is 430) was a 56px column containing
           full-width text rows clipped to 40px: "Documenta…", "Cultur…", one under the
           other, with no icon to fall back on because most nav items declare none.

           So: persistent when there is room, a real temporary overlay when there is not.
           Both variants MudBlazor styles correctly on its own. *@
        @* @key on the variant is load-bearing, not tidiness. MudLayout stamps its content
           offset (mud-drawer-open-persistent-left → margin-left) from the variant a drawer
           had when it REGISTERED with the container, and changing Variant on a live instance
           does not restamp it. Cross the breakpoint and the drawer becomes docked while the
           layout still believes it is an overlay, so the page body keeps margin-left:0 and
           renders UNDERNEATH the navigation — the columns visibly sitting on top of each
           other. Rekeying disposes the drawer and registers a fresh one, which is the only
           point at which that class is recomputed. *@
        @* Keys must be unique among SIBLINGS, and the rail below is one — keying both on the
           bare DrawerVariant makes them collide the moment both are Persistent. *@
        <MudDrawer @key="@($"nav-{_leftDrawerVariant}")"
                   @bind-Open="_leftDrawerOpen"
                   Anchor="Anchor.Start"
                   Elevation="2"
                   ClipMode="DrawerClipMode.Always"
                   Variant="_leftDrawerVariant"
                   Width="@($"{Site.Layout.LeftDrawerWidth}px")">
            @* Plain <nav>/<ul> instead of MudNavMenu: the tree below is built from
               <details>/<summary>, so it expands without JavaScript and without a Blazor
               circuit. See RenderNavGroup.razor and wwwroot/zonit-dashboard.css. *@
            <nav class="znav" aria-label="@Culture.Translate("Main navigation").Value">
                @{ var topLevelHasIcons = NavRender.AnyIcon(NavGroups); }
                <ul>
                    @foreach (var group in NavGroups)
                    {
                        <RenderNavGroup Group="@group" ReserveIcon="@topLevelHasIcons" />
                    }
                </ul>
            </nav>
        </MudDrawer>
    }

    @* ─── Right drawer per extension (single-active-per-anchor) ───
         Class="zpanel" does two things the markup cannot. It lifts these above the rail — both
         are Anchor=End MudDrawers and MudBlazor gives every drawer the SAME z-index, so paint
         order decided the winner and the rail, being later in this file, covered the panel the
         visitor had just asked for. Measured on a 390px viewport: tapping "Language" in the rail
         opened a 320px panel of which only the leftmost 100px was visible and clickable, the rest
         underneath the rail. That is exactly the "the right-hand navigation overlaps the
         slide-out and it stops being clickable" report. The layout also closes the rail now (see
         SyncOverlayDrawers) — this is the belt to that pair of braces.

         The second job is width: a fixed 320px panel on a 360px phone leaves a 40px strip of
         page, which reads as a broken overlay rather than a panel. See .zpanel in dashboard.css. *@
    @foreach (var ext in (Site.Layout.ShowRightDrawer ? RightAnchorDrawerExtensions : []))
    {
        var state = DrawerStates.GetState(ext.Id);
        var isOpen = state?.IsOpen ?? false;
        @* 0 means "take the mount's width" — see IDrawerExtension.Width. *@
        var width = ext.Width > 0 ? ext.Width : Site.Layout.RightDrawerWidth;
        <MudDrawer Open="@isOpen"
                   OpenChanged="@((bool v) => OnDrawerOpenChanged(ext.Id, v))"
                   Anchor="Anchor.End"
                   Elevation="2"
                   Variant="DrawerVariant.Temporary"
                   Class="zpanel"
                   Width="@($"{width}px")">
            @ext.CreateDrawerContent()
        </MudDrawer>
    }

    @* ─── Right rail: persistent column of inline switchers (user / theme / org
         / project / culture). Restores the legacy Zonit.Services.Dashboard right
         drawer UX. Auto-collapses on phones because two persistent drawers eat
         the whole viewport. ─── *@
    @if (Site.Layout.ShowRightRail)
    {
        @* Same reason as the left drawer — see the @key comment there. *@
        @* Class="zrail" carries the mobile width override: 220px is a sensible docked column and
           a cramped overlay, so as an overlay it widens to a phone-appropriate size. *@
        <MudDrawer @key="@($"rail-{_rightRailVariant}")"
                   Open="@_rightRailOpen"
                   OpenChanged="@OnRightRailOpenChanged"
                   Anchor="Anchor.End"
                   Elevation="2"
                   ClipMode="DrawerClipMode.Always"
                   Variant="_rightRailVariant"
                   Class="zrail"
                   Width="@($"{Site.Layout.RightRailWidth}px")">
            <RightRail />
        </MudDrawer>
    }

    @* ─── Main content ─── *@
    <MudMainContent>
        @* ONE container for the crumbs, the heading and the body.

           They used to sit in two, each with its own padding, which meant the trail and the title
           agreed on their left edge only by coincidence: any page whose PageWidth changed between
           the two renders, or any future edit to one of the two Class strings, would step them
           apart. It also stacked pt-3 on top of py-4 under a 48px MudMainContent offset, pushing
           the heading roughly 90px down a phone screen before a single word of content. *@
        <MudContainer MaxWidth="@ContentWidth" Class="zpage">
            @if (Site.Layout.ShowBreadcrumbs && VisibleCrumbs.Count > 0)
            {
                @* Plain markup, not MudBreadcrumbs — see the .zcrumbs block in dashboard.css. The
                   short version: a crumb with nowhere to go must not be an <a>. *@
                <nav aria-label="@Culture.Translate("Breadcrumb").Value">
                    <ol class="zcrumbs">
                        @for (var i = 0; i < VisibleCrumbs.Count; i++)
                        {
                            var crumb = VisibleCrumbs[i];
                            var isCurrent = i == VisibleCrumbs.Count - 1 && !TitleReplacesLastCrumb;
                            <li>
                                @if (!isCurrent && crumb.Href.HasValue)
                                {
                                    <a href="@crumb.Href.ToHref()">@Culture.Translate(crumb.Text.Value).Value</a>
                                }
                                else
                                {
                                    <span aria-current="@(isCurrent ? "page" : null)">@Culture.Translate(crumb.Text.Value).Value</span>
                                }
                            </li>
                        }
                    </ol>
                </nav>
            }

            @if (Site.Layout.ShowPageTitle && PageTitle is { Length: > 0 } heading)
            {
                @* A real <h1>, sized by .zpage-title in dashboard.css rather than by the
                   mud-typography-h1 class it used to borrow. MudBlazor emits typography as inline
                   style from MudText, not as a class rule, so "mud-typography-h1" on a bare <h1>
                   was styling nothing and the heading was rendering at the browser's own 2em.
                   Not <MudText Typo="Typo.h1"> either: MudText picks its element from Typo, and
                   asking for a smaller size would emit <h5>, leaving a page whose only heading is
                   an <h5> — no document outline for a screen reader or a crawler.

                   The size is fluid, which is the point of the rule: a fixed 1.75rem heading on a
                   360px phone spends three lines on a title like "Value objects — identity". *@
                <h1 class="zpage-title">@heading</h1>
            }

            <div class="zpage-body">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>

</MudLayout>
</MudSwipeArea>
</MudRTLProvider>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
