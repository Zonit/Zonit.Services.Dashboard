@*
    Right-side drawer body for the culture (language) switcher. Lists all
    supported cultures with their flag icon + name, lets the user pick
    one, and closes the drawer once the selection is committed.

    Reads from ICultureProvider (current) + ICultureState (supported list) and
    writes via ICultureManager.SetCulture(...) so the change propagates through
    every scope subscribed to ICultureState.OnChange.
*@
@namespace Zonit.Dashboard.Components.Drawers
@using Zonit.Dashboard.Extensions
@using Zonit.Extensions
@using Zonit.Extensions.Cultures
@using Zonit.Extensions.Website
@implements IDisposable

@inject ICultureProvider Culture
@inject ICultureState CultureState
@inject ICultureManager CultureManager
@inject IExtensionDrawerStates DrawerStates
@inject ICookieProvider Cookies

<PanelHeader Title="@Culture.Translate("Select language").ToString()" OnClose="@Close" />

<div class="zpanel-body">
    @*
        Always present, matching the pre-refactor panel. An earlier pass here hid it below eight
        languages on the theory that a short list does not need filtering — but the host's
        supported set is configuration, the panel cannot know how long it will be in someone
        else's deployment, and a control that appears and disappears with the data is worse than
        one that is simply always where you left it.
    *@
    <MudTextField @bind-Value="_search"
                  Placeholder="@Culture.Translate("Search languages...").ToString()"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Margin="Margin.Dense"
                  Class="mb-3"
                  Clearable="true"
                  Immediate="true" />

    @if (FilteredLanguages.Count > 0)
    {
        @*
            Lower-cased on purpose. Culture.Current.Value is the canonical ICU tag ("pl-PL");
            LanguageModel.Code is documented and implemented as lower-case ("pl-pl"), and that is
            what each row carries as its Value. MudList compares the two ordinally, so they never
            matched and the picker opened with nothing selected no matter which language was
            active — the one row that should have been obvious was the one that never highlighted.
        *@
        <MudList T="string"
                 SelectedValue="@CurrentCode"
                 SelectedValueChanged="@SwitchAsync">
            @foreach (var lang in FilteredLanguages)
            {
                <MudListItem Value="@lang.Code">
                    <div class="d-flex align-center" style="gap: .75rem; min-width: 0;">
                        @*
                            Rendered here rather than through MudListItem's Icon slot. That slot is
                            sized for a 24px monochrome Material glyph and these are 32x32 flag
                            documents with their own viewBox — .zpanel-flag gives them a box they
                            fit and a small radius so a rectangle of national colours does not read
                            as a stray graphic.
                        *@
                        <span class="zpanel-flag">@((MarkupString)lang.IconFlag)</span>
                        <div class="d-flex flex-column" style="min-width: 0;">
                            <span>@Culture.Translate(lang.EnglishName)</span>
                            @*
                                The native name, for anyone hunting for a language they cannot
                                currently read — the one place in the chrome where it belongs.
                                Suppressed when it says the same thing as the line above it.
                            *@
                            @if (!string.Equals(lang.NativeName, Culture.Translate(lang.EnglishName).ToString(),
                                                StringComparison.OrdinalIgnoreCase))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@lang.NativeName</MudText>
                            }
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
    else
    {
        <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Class="pa-4 mud-text-secondary">
            @Culture.Translate("No languages found")
        </MudText>
    }
</div>

@code {
    private string _search = string.Empty;

    private IReadOnlyList<LanguageModel> FilteredLanguages
    {
        get
        {
            var all = CultureState.Supported;
            if (string.IsNullOrWhiteSpace(_search)) return all;

            var s = _search.Trim();
            return all
                .Where(l =>
                    l.EnglishName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    l.NativeName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    // The tag itself, so someone who thinks in "pl" or "de-DE" can find the row.
                    l.Code.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    Culture.Translate(l.EnglishName).ToString().Contains(s, StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }
    }

    protected override void OnInitialized()
    {
        Culture.OnChange += OnExternalChange;
    }

    private void OnExternalChange() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Name of the cookie <c>CultureMiddleware</c> negotiates language from.
    /// </summary>
    /// <remarks>
    /// <para><b>A literal, deliberately, and temporarily.</b> The kernel owns this contract and
    /// now exposes it as <c>Zonit.Extensions.Website.Cultures.CultureCookie.Name</c> — but this
    /// package is built two ways: against the kernel SOURCE inside the Zonit.Sdk workspace, and
    /// against the PUBLISHED <c>Zonit.Extensions.Website</c> package everywhere else, which is
    /// what the NuGet publish workflow does. Referencing a kernel type that has not shipped yet
    /// compiles locally and breaks the release build — it did, with exactly this line.</para>
    ///
    /// <para><b>Delete this once the kernel ships</b> and the pin in Directory.Packages.props is
    /// bumped past it: replace with <c>CultureCookie.PersistAsync(Cookies, code)</c>. Until then
    /// the value is duplicated rather than the feature dropped, because without the write the
    /// language switcher silently forgets the choice on the next navigation.</para>
    ///
    /// <para>Lower-cased on write to match <c>CultureMiddleware.TryNormalize</c>, and left at
    /// <c>CookieModel</c>'s default <c>Path="/"</c> — a document.cookie write with no path is
    /// scoped to the current DIRECTORY, which would lose the choice as soon as the visitor moved
    /// to a page at a different depth.</para>
    /// </remarks>
    private const string LanguageCookie = "lang";

    /// <summary>The active culture in the same casing the list items use.</summary>
    private string CurrentCode => Culture.Current.HasValue
        ? Culture.Current.ValueOrDefault.ToLowerInvariant()
        : string.Empty;

    private async Task SwitchAsync(string code)
    {
        // Ordinal-ignore-case, for the same reason CurrentCode exists: "pl-pl" and "pl-PL" are the
        // same language, and an ordinal == here meant re-picking the active language ran a full
        // switch instead of doing nothing.
        if (string.IsNullOrEmpty(code) ||
            string.Equals(code, Culture.Current.Value, StringComparison.OrdinalIgnoreCase))
            return;

        CultureManager.SetCulture(global::Zonit.Extensions.Culture.TryCreate(code, out var c) ? c : global::Zonit.Extensions.Culture.Default);

        // SetCulture only moves the scoped state. CultureMiddleware resolves the next request from
        // the "lang" cookie before anything else, so without this write the page turns Polish and
        // the very next navigation turns it back — a language switcher that appears to work and
        // then silently undoes itself.
        await Cookies.SetAsync(LanguageCookie, code.ToLowerInvariant(), TimeSpan.FromDays(365));

        Close();
    }

    private void Close()
        => DrawerStates.GetState("zonit.dashboard.culture")?.Close();

    public void Dispose()
    {
        Culture.OnChange -= OnExternalChange;
    }
}
