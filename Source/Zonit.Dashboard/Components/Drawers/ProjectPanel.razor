@*
    Right-side drawer body for the project (catalog) switcher. Twin of
    WorkspacePanel — same UX, different backing service (ICatalogProvider /
    ICatalogManager from Zonit.Extensions.Projects).
*@
@namespace Zonit.Dashboard.Components.Drawers
@using Zonit.Dashboard.Extensions
@using Zonit.Extensions
@using Zonit.Extensions.Cultures
@using Zonit.Extensions.Projects
@using Zonit.Extensions.Website.MudBlazor
@implements IDisposable

@inject ICultureProvider Culture
@inject ICatalogProvider Catalog
@inject ICatalogManager CatalogManager
@inject IExtensionDrawerStates DrawerStates
@inject NavigationManager Nav

<PanelHeader Title="@Culture.Translate("Projects").ToString()" OnClose="@Close" />

<div class="zpanel-body">
    @if (Catalog.Project.HasValue)
    {
        var currentName = Catalog.Project.Name.HasValue
            ? Catalog.Project.Name.Value
            : Catalog.Project.Id.ToString();

        <div class="zpanel-current">
            <MudAvatar Color="MudBlazor.Color.Secondary" Rounded="true" Style="height: 72px; width: 72px; font-size: 1.75rem;">
                @(currentName.Length > 0 ? currentName[..1].ToUpperInvariant() : "?")
            </MudAvatar>
            <div class="zpanel-current-name">@currentName</div>
        </div>

        <MudDivider Class="mb-2" />

        @if (CatalogManager.Projects is { Count: > 0 } projects)
        {
            <div class="zpanel-section">@Culture.Translate("Your projects")</div>

            @*
                Always present, matching the pre-refactor panel — the same reasoning as the language
                picker: how long this list is, is the host's data, not something the panel can predict.
            *@
            <MudTextField @bind-Value="_search"
                          Placeholder="@Culture.Translate("Search projects...").ToString()"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Class="mb-2"
                          Clearable="true"
                          Immediate="true" />

            var filtered = Filter(projects);

            @if (filtered.Count > 0)
            {
                <MudList T="Guid" SelectedValue="@Catalog.Project.Id" SelectedValueChanged="@SwitchAsync">
                    @foreach (var p in filtered)
                    {
                        <MudListItem Value="@p.Id" Text="@p.Name" />
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Class="pa-4 mud-text-secondary">
                    @Culture.Translate("No projects found")
                </MudText>
            }

            <MudDivider Class="my-2" />
        }

        @*
            One row, and it is the one the pre-refactor panel had. The refactor added
            "projects/settings" and "projects/new" alongside it — neither is a route the Projects
            area registers, so both were buttons that navigated to a 404. An invented destination
            is worse than a missing one: it looks like a feature until it is pressed.
        *@
        <MudList T="string">
            <MudListItem OnClick="@(() => Go("projects"))" Icon="@Icons.Material.Outlined.SwapHoriz">
                @Culture.Translate("Manage projects")
            </MudListItem>
        </MudList>
    }
    else
    {
        <EmptyState Icon="@Icons.Material.Outlined.Folder"
                    Title="@Culture.Translate("No project selected").ToString()"
                    Description="@Culture.Translate("Create or join a project to get started.").ToString()"
                    MinHeight="240px" />
    }
</div>

@code {
    private string _search = string.Empty;

    protected override void OnInitialized()
    {
        Culture.OnChange += OnExternalChange;
        Catalog.OnChange += OnExternalChange;
    }

    private void OnExternalChange() => InvokeAsync(StateHasChanged);

    private IReadOnlyList<ProjectModel> Filter(IReadOnlyCollection<ProjectModel> source)
    {
        if (string.IsNullOrWhiteSpace(_search)) return source.ToArray();

        var s = _search.Trim();
        return source
            .Where(p => p.Name.Contains(s, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private async Task SwitchAsync(Guid projectId)
    {
        if (projectId == Catalog.Project.Id) return;
        await CatalogManager.SwitchProjectAsync(projectId);
        Close();
    }

    private void Go(string relativeUrl)
    {
        Close();
        Nav.NavigateTo(relativeUrl);
    }

    private void Close()
        => DrawerStates.GetState("zonit.dashboard.project")?.Close();

    public void Dispose()
    {
        Culture.OnChange -= OnExternalChange;
        Catalog.OnChange -= OnExternalChange;
    }
}
