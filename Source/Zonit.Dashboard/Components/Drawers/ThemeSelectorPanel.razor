@*
    UI body for the built-in "Theme" drawer extension. Lists every registered
    IDashboardTheme as a radio choice plus the three ThemeMode options. All
    mutations go through IThemeManager.SetThemeAsync / SetModeAsync, which
    persist to cookies and raise OnChange — the surrounding DashboardMainLayout
    subscribes to that event and re-renders the MudThemeProvider.
*@
@implements IDisposable
@namespace Zonit.Dashboard.Components.Drawers
@using Zonit.Dashboard.Extensions
@using Zonit.Dashboard.Themes
@using Zonit.Extensions.Cultures

@inject IThemeManager ThemeManager
@inject ICultureProvider Culture
@inject IExtensionDrawerStates DrawerStates

@*
    This panel had neither a header nor a close button while its three siblings had both, so on a
    phone — where the panel covers the screen — the only way out was to find the scrim. It also
    stated its strings in English while every other panel translated them.
*@
<PanelHeader Title="@Culture.Translate("Appearance").ToString()" OnClose="@Close" />

<div class="zpanel-body">
    <div class="zpanel-section">@Culture.Translate("Mode")</div>
    @*
        Mode first. It is the control people come here for — "make it dark" — and it was underneath
        a list of three palettes, below the fold on a phone.
    *@
    <MudRadioGroup T="ThemeMode"
                   Value="@ThemeManager.Mode"
                   ValueChanged="@OnModeChanged"
                   Class="mb-4">
        <MudRadio T="ThemeMode" Value="ThemeMode.Auto" Color="MudBlazor.Color.Primary" Dense="true">
            <MudText Typo="Typo.body2">@Culture.Translate("Auto")</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Culture.Translate("Follow the system setting")</MudText>
        </MudRadio>
        <MudRadio T="ThemeMode" Value="ThemeMode.Light" Color="MudBlazor.Color.Primary" Dense="true">
            <MudText Typo="Typo.body2">@Culture.Translate("Light")</MudText>
        </MudRadio>
        <MudRadio T="ThemeMode" Value="ThemeMode.Dark" Color="MudBlazor.Color.Primary" Dense="true">
            <MudText Typo="Typo.body2">@Culture.Translate("Dark")</MudText>
        </MudRadio>
    </MudRadioGroup>

    @* A single registered theme is not a choice; the whole block goes rather than presenting one
       radio button that cannot be un-picked. *@
    @if (ThemeManager.Available.Count > 1)
    {
        <MudDivider Class="my-3" />

        <div class="zpanel-section">@Culture.Translate("Theme")</div>
        <MudRadioGroup T="string"
                       Value="@ThemeManager.Current.Id"
                       ValueChanged="@OnThemeChanged">
            @foreach (var theme in ThemeManager.Available)
            {
                <MudRadio T="string" Value="@theme.Id" Color="MudBlazor.Color.Primary" Dense="true">
                    <MudText Typo="Typo.body2"><b>@Culture.Translate(theme.Name)</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Culture.Translate(theme.Description)</MudText>
                </MudRadio>
            }
        </MudRadioGroup>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        // Re-render when the theme changes externally (cookie hydration on first
        // render, theme-switch from another tab, etc.). InvokeAsync because the
        // event may fire off the synchronisation context.
        ThemeManager.OnChange += OnThemeManagerChanged;
        Culture.OnChange += OnThemeManagerChanged;
    }

    private void OnThemeManagerChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnThemeChanged(string themeId)
        => await ThemeManager.SetThemeAsync(themeId);

    private async Task OnModeChanged(ThemeMode mode)
        => await ThemeManager.SetModeAsync(mode);

    private void Close()
        => DrawerStates.GetState("zonit.dashboard.theme")?.Close();

    public void Dispose()
    {
        ThemeManager.OnChange -= OnThemeManagerChanged;
        Culture.OnChange -= OnThemeManagerChanged;
    }
}
