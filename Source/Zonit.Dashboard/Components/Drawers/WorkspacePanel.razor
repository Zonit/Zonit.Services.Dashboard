@*
    Right-side drawer body for the workspace (organization) switcher. Renders
    the current organization at the top and lets the user pick a different one
    from IWorkspaceManager.Organizations. Picking an org calls
    IWorkspaceManager.SwitchOrganizationAsync(...) which propagates through
    ICatalogManager (re-hydrating projects) — the drawer closes itself once the
    switch completes.

    Anonymous / no-workspace users see an empty state.
*@
@namespace Zonit.Dashboard.Components.Drawers
@using Zonit.Dashboard.Extensions
@using Zonit.Extensions
@using Zonit.Extensions.Cultures
@using Zonit.Extensions.Organizations
@using Zonit.Extensions.Website.MudBlazor
@implements IDisposable

@inject ICultureProvider Culture
@inject IWorkspaceProvider Workspace
@inject IWorkspaceManager WorkspaceManager
@inject IExtensionDrawerStates DrawerStates
@inject NavigationManager Nav

<PanelHeader Title="@Culture.Translate("Organizations").ToString()" OnClose="@Close" />

<div class="zpanel-body">
    @if (Workspace.Organization.HasValue)
    {
        var currentName = Workspace.Organization.Name.HasValue
            ? Workspace.Organization.Name.Value
            : Workspace.Organization.Id.ToString();

        <div class="zpanel-current">
            <MudAvatar Color="MudBlazor.Color.Primary" Rounded="true" Style="height: 72px; width: 72px; font-size: 1.75rem;">
                @(currentName.Length > 0 ? currentName[..1].ToUpperInvariant() : "?")
            </MudAvatar>
            <div class="zpanel-current-name">@currentName</div>
        </div>

        <MudDivider Class="mb-2" />

        @if (WorkspaceManager.Organizations is { Count: > 0 } orgs)
        {
            <div class="zpanel-section">@Culture.Translate("Your organizations")</div>

            @*
                Always present, matching the pre-refactor panel — the same reasoning as the language
                picker: how long this list is, is the host's data, not something the panel can predict.
            *@
            <MudTextField @bind-Value="_search"
                          Placeholder="@Culture.Translate("Search organizations...").ToString()"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Class="mb-2"
                          Clearable="true"
                          Immediate="true" />

            var filtered = Filter(orgs);

            @if (filtered.Count > 0)
            {
                <MudList T="Guid" SelectedValue="@Workspace.Organization.Id" SelectedValueChanged="@SwitchAsync">
                    @foreach (var org in filtered)
                    {
                        <MudListItem Value="@org.Id" Text="@org.Name" />
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Class="pa-4 mud-text-secondary">
                    @Culture.Translate("No organizations found")
                </MudText>
            }

            <MudDivider Class="my-2" />
        }

        @* Only the route the Organizations area actually registers. "organizations/team" and
           "organizations/settings" were added by the refactor and neither exists — see the same
           note on ProjectPanel. *@
        <MudList T="string">
            <MudListItem OnClick="@(() => Go("organizations"))" Icon="@Icons.Material.Outlined.SwapHoriz">
                @Culture.Translate("Manage organizations")
            </MudListItem>
        </MudList>

        <MudDivider Class="my-3" />

        @* "organizations/switch" was not a route — the Organizations area registers
           "organizations/switcher". One missing two letters, on the panel's only filled button. *@
        <MudButton OnClick="@(() => Go("organizations/switcher"))"
                   Variant="Variant.Filled" Color="MudBlazor.Color.Primary" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Add" Class="mt-2">
            @Culture.Translate("Join")
        </MudButton>
    }
    else
    {
        <EmptyState Icon="@Icons.Material.Outlined.Business"
                    Title="@Culture.Translate("No organization selected").ToString()"
                    Description="@Culture.Translate("You are not a member of any workspace yet.").ToString()"
                    MinHeight="240px" />
    }
</div>

@code {
    private string _search = string.Empty;

    protected override void OnInitialized()
    {
        Culture.OnChange += OnExternalChange;
        Workspace.OnChange += OnExternalChange;
    }

    private void OnExternalChange() => InvokeAsync(StateHasChanged);

    private IReadOnlyList<OrganizationModel> Filter(IReadOnlyCollection<OrganizationModel> source)
    {
        if (string.IsNullOrWhiteSpace(_search)) return source.ToArray();

        var s = _search.Trim();
        return source
            .Where(o => o.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                     || o.FullName.Contains(s, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private async Task SwitchAsync(Guid organizationId)
    {
        if (organizationId == Workspace.Organization.Id) return;
        await WorkspaceManager.SwitchOrganizationAsync(organizationId);
        Close();
    }

    private void Go(string relativeUrl)
    {
        Close();
        Nav.NavigateTo(relativeUrl);
    }

    private void Close()
        => DrawerStates.GetState("zonit.dashboard.workspace")?.Close();

    public void Dispose()
    {
        Culture.OnChange -= OnExternalChange;
        Workspace.OnChange -= OnExternalChange;
    }
}
